# --------------------------------------------------------------------------
# Colours and terminal output
# --------------------------------------------------------------------------

def _style(code: str) -> str:
    return f"\x1b[{code}m"


RESET = _style("0")
BOLD = _style("1")
GRAY = _style("38;5;244")
WHITE = _style("38;5;255")
CYAN = _style("38;5;81")
GREEN = _style("38;5;114")
YELLOW = _style("38;5;221")
RED = _style("38;5;203")
CURSOR_ROW = _style("48;5;236")           # background of the row under the cursor
BADGE = _style("1;38;5;235;48;5;81")      # " 1337 " in dark text on cyan

HIDE_CURSOR = "\x1b[?25l"
SHOW_CURSOR = "\x1b[?25h"
CLEAR_BELOW = "\x1b[J"


def _width() -> int:
    """Usable terminal width. One column is kept free so lines never wrap."""
    return shutil.get_terminal_size().columns - 1


def _height() -> int:
    return shutil.get_terminal_size().lines


def _line(pieces: list, background: str = "", cut: bool = True) -> str:
    """Join (text, style) pieces into one line, cut to the terminal width.

    Cutting is done on the plain text, before colours are added, so a long
    line can never wrap and break the picker's redraw. Messages that must be
    read in full pass cut=False.
    """
    width = _width() if cut else sys.maxsize
    used = 0
    line = ""
    for text, style in pieces:
        text = text[:max(0, width - used)]
        used += len(text)
        line += background + style + text + RESET
    if background:
        line += background + " " * max(0, width - used) + RESET
    return line


def intro(text: str) -> None:
    """The opening line, before the first prompt."""
    print(_line([("┌  ", GRAY), (" 1337 ", BADGE), ("  " + text, WHITE)]))
    print(_line([("│", GRAY)]))


def outro(text: str, style: str = GREEN) -> None:
    """The closing line, after the last prompt."""
    print(_line([("└  ", GRAY), (text, style)]))


def gap() -> None:
    """An empty line between two prompts or steps."""
    print(_line([("│", GRAY)]))


def fail(title: str, problems: list, hint: str) -> None:
    """Print a list of problems and stop with exit code 1."""
    print(_line([("■  ", RED), (title, BOLD + RED)], cut=False), file=sys.stderr)
    for problem in problems:
        print(_line([("│  ", GRAY), (problem, WHITE)], cut=False), file=sys.stderr)
    print(_line([("└  ", GRAY), (hint, GRAY)], cut=False), file=sys.stderr)
    sys.exit(1)


# --------------------------------------------------------------------------
# Prompts: the checkbox picker, text and yes/no questions
# --------------------------------------------------------------------------

@dataclass
class Choice:
    """One line in the picker."""

    name: str
    detail: str = ""                      # shown in gray, e.g. the dest folder
    needs: list = field(default_factory=list)
    tag: str = ""                         # shown in green, e.g. "installed"


def _answered(title: str, text: str) -> list:
    """What a prompt collapses to once answered."""
    # Not cut to the terminal width: nothing is redrawn after this, and the
    # whole answer should be readable.
    return [
        _line([("◇  ", GREEN), (title, WHITE)]),
        _line([("│  ", GRAY), (text, GRAY)], cut=False),
        _line([("│", GRAY)]),
    ]


def _summary(title: str, picked: list) -> list:
    """What a checkbox prompt collapses to after enter."""
    return _answered(title, ", ".join(picked) if picked else "nothing")


def _cancelled(title: str) -> list:
    return [
        _line([("■  ", RED), (title, WHITE)]),
        _line([("│  ", GRAY), ("cancelled", RED)]),
    ]


def _screen(title: str, choices: list, checked: list, cursor: int, top: int,
            visible: int) -> list:
    """Every line of the open prompt, as it should look right now."""
    name_width = max(len(c.name) for c in choices) + 2
    detail_width = max(len(c.detail) for c in choices) + 2

    count = f"  {sum(checked)} of {len(choices)}"
    lines = [_line([("◆  ", CYAN), (title, BOLD + CYAN), (count, GRAY)])]

    if top > 0:
        lines.append(_line([("│     ", GRAY), (f"↑ {top} more", GRAY)]))

    for index in range(top, min(top + visible, len(choices))):
        choice = choices[index]
        here = index == cursor

        pieces = [("│  ", GRAY)]
        pieces.append(("❯ " if here else "  ", CYAN))
        pieces.append(("◼ " if checked[index] else "◻ ",
                       GREEN if checked[index] else GRAY))
        name_style = BOLD + WHITE if here else (WHITE if checked[index] else GRAY)
        pieces.append((choice.name.ljust(name_width), name_style))
        if choice.detail:
            pieces.append((choice.detail.ljust(detail_width), GRAY))
        if choice.needs:
            pieces.append(("+ " + ", ".join(choice.needs) + "  ", YELLOW))
        if choice.tag:
            pieces.append((choice.tag, GREEN))

        lines.append(_line(pieces, CURSOR_ROW if here else ""))

    hidden_below = len(choices) - (top + visible)
    if hidden_below > 0:
        lines.append(_line([("│     ", GRAY), (f"↓ {hidden_below} more", GRAY)]))

    lines.append(_line([
        ("└  ", GRAY),
        ("↑/↓", WHITE), (" move   ", GRAY),
        ("space", WHITE), (" toggle   ", GRAY),
        ("a", WHITE), (" all   ", GRAY),
        ("enter", WHITE), (" confirm", GRAY),
    ]))
    return lines


UP = (b"\x1b[A", b"k")
DOWN = (b"\x1b[B", b"j")
TOGGLE = (b" ",)
ALL = (b"a",)
CONFIRM = (b"\r", b"\n")


def _read_key(fd: int) -> bytes:
    """One key press. Arrow keys arrive as three bytes starting with ESC."""
    key = os.read(fd, 1)
    if key == b"\x1b":
        ready, _, _ = select.select([fd], [], [], 0.05)
        if ready:
            key += os.read(fd, 2)
    return key


def choose(title: str, choices: list, checked: list = None) -> list:
    """Show a checkbox prompt and return the picked names, in their order.

    Every box starts checked, unless `checked` says otherwise. Ctrl-C
    restores the terminal and raises KeyboardInterrupt, so the caller can
    stop cleanly.
    """
    if not choices:
        for line in _summary(title, []):
            print(line)
        return []

    checked = list(checked) if checked is not None else [True] * len(choices)
    cursor = 0
    top = 0
    drawn = 0

    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)

    def draw(lines: list) -> None:
        nonlocal drawn
        if drawn:
            sys.stdout.write(f"\x1b[{drawn}F")      # back to the first line
        sys.stdout.write(CLEAR_BELOW + "\n".join(lines) + "\n")
        sys.stdout.flush()
        drawn = len(lines)

    try:
        tty.setcbreak(fd)
        sys.stdout.write(HIDE_CURSOR)
        while True:
            # Title, footer and two "more" lines take four rows.
            visible = max(3, _height() - 5)
            if cursor < top:
                top = cursor
            if cursor >= top + visible:
                top = cursor - visible + 1
            draw(_screen(title, choices, checked, cursor, top, visible))

            key = _read_key(fd)
            if key in UP:
                cursor = (cursor - 1) % len(choices)
            elif key in DOWN:
                cursor = (cursor + 1) % len(choices)
            elif key in TOGGLE:
                checked[cursor] = not checked[cursor]
            elif key in ALL:
                checked = [not all(checked)] * len(choices)
            elif key in CONFIRM:
                break
    except KeyboardInterrupt:
        draw(_cancelled(title))
        raise
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write(SHOW_CURSOR)
        sys.stdout.flush()

    picked = [c.name for c, on in zip(choices, checked) if on]
    draw(_summary(title, picked))
    return picked


def _read_line(title: str, hint: str, secret: bool = False) -> str:
    """One line typed under `title`, stripped. The caller prints the answer.

    Without a terminal the line comes from stdin and nothing is drawn.
    """
    if not ASK:
        return sys.stdin.readline().strip()
    print(_line([("◆  ", CYAN), (title, BOLD + CYAN), ("  " + hint, GRAY)]))
    read = getpass.getpass if secret else input
    try:
        answer = read(_line([("│  ", GRAY)])).strip()
    except EOFError:
        answer = ""
    sys.stdout.write("\x1b[2F" + CLEAR_BELOW)          # back over the title
    return answer


def ask(title: str, default: str = "", secret: bool = False) -> str:
    """A line of text. Enter alone keeps `default`."""
    answer = _read_line(title, f"enter keeps {default}" if default else "",
                        secret) or default
    shown = "(hidden)" if secret and answer else answer or "nothing"
    for line in _answered(title, shown):
        print(line)
    return answer


def confirm(title: str, default: bool = True) -> bool:
    """A yes or no question. Enter alone keeps `default`."""
    answer = _read_line(title, "Y/n" if default else "y/N").lower()
    yes = answer.startswith("y") if answer else default
    for line in _answered(title, "yes" if yes else "no"):
        print(line)
    return yes


# --------------------------------------------------------------------------
# Reading ~/1337.yml
# --------------------------------------------------------------------------

ITEM_SECTIONS = ("relocated", "tools", "synced", "repos")
STEP_SECTIONS = ("login", "logout")
SECTIONS = ("variables",) + ITEM_SECTIONS + STEP_SECTIONS

#: The sections whose items are git repos: cloned at login, pushed at logout.
REPO_SECTIONS = ("synced", "repos")

#: Every item keyword, and the kind of value it takes.
ITEM_KEYS = {
    "source": "text",
    "dest": "text",
    "link": "text",
    "setup": "list",
    "path": "list",
    "env": "variables",
    "squash": "true/false",
    "gitignore": "list",
    "needs": "list",
}

#: Keywords an item must have, per section.
REQUIRED_KEYS = {
    "relocated": ("dest", "link"),
    "tools": ("dest", "setup"),
    "synced": ("source", "dest", "link"),
    "repos": ("source", "dest"),
}

#: Keywords that mean nothing in a section, so writing one is a mistake.
UNUSED_KEYS = {
    "relocated": ("source", "squash", "gitignore"),
    "tools": ("squash", "gitignore"),
    "synced": (),
    "repos": (),
}

#: Every step keyword, and the kind of value it takes.
STEP_KEYS = {
    "run": "list",
    "do": "text",
    "ignore_errors": "true/false",
    "message": "text",
    "choose": "true/false",
    "options": "list",
}

ACTIONS = ("link", "install", "sync", "clone", "push", "unlink")

#: The `do` actions that set up the items of one section; `choose` picks among them.
ACTION_SECTIONS = {"link": "relocated", "install": "tools", "sync": "synced",
                   "clone": "repos"}


class _Loader(yaml.SafeLoader):
    """A SafeLoader that refuses a key written twice in the same map.

    Plain PyYAML silently keeps the last one, so a second `flutter:` would
    quietly replace the first.
    """


def _map_without_duplicates(loader: _Loader, node: yaml.MappingNode) -> dict:
    seen = set()
    for key_node, _ in node.value:
        key = loader.construct_object(key_node)
        if key in seen:
            raise yaml.constructor.ConstructorError(
                None, None, f"{key!r} is written twice", key_node.start_mark)
        seen.add(key)
    return loader.construct_mapping(node, deep=True)


_Loader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
                        _map_without_duplicates)


def _is_name(text: object) -> bool:
    """Whether `text` can be a shell variable name."""
    return (isinstance(text, str) and text != ""
            and (text[0].isalpha() or text[0] == "_")
            and all(c.isalnum() or c == "_" for c in text)
            and text.isascii())


def _is_value(value: object) -> bool:
    """Text or a whole number.

    true/false is refused because Python would write it as True, and decimals
    because YAML reads a version like 3.10 as the number 3.1.
    """
    return isinstance(value, (str, int)) and not isinstance(value, bool)


def _type_problem(where: str, value: object, kind: str) -> list:
    """An empty list when `value` is of `kind`, else one problem."""
    if kind == "text" and isinstance(value, str):
        return []
    if kind == "true/false" and isinstance(value, bool):
        return []
    if kind == "list" and isinstance(value, list) \
            and all(isinstance(entry, str) for entry in value):
        return []
    if kind == "variables" and isinstance(value, dict):
        return _variables_problems(where, value)
    return [f"{where} must be {_KIND_NAMES[kind]}"]


_KIND_NAMES = {
    "text": "text",
    "true/false": "true or false",
    "list": "a list of text",
    "variables": "a map of NAME: value",
}


#: Variables 1337 relies on or sets itself, so ~/1337.yml must not define them.
#: PATH is extended with the `path` keyword instead.
RESERVED_NAMES = ("PATH", "HOME", "USER", "SOURCE", "DEST", "CHOSEN", "SKIPPED")


def _variables_problems(where: str, variables: dict) -> list:
    problems = []
    for name, value in variables.items():
        if not _is_name(name):
            problems.append(f"{where}: {name!r} is not a valid variable name")
        elif name in RESERVED_NAMES:
            problems.append(f"{where}: {name} is set by 1337 itself, pick another name")
        elif not _is_value(value):
            problems.append(f"{where}.{name} must be text or a whole number "
                            "(put quotes around yes, no, true, false and "
                            "versions like 3.10)")
    return problems


def _item_problems(section: str, name: str, item: object) -> list:
    where = f"{section}.{name}"
    if not isinstance(item, dict):
        return [f"{where} must be a map of keywords"]

    problems = []
    for key, value in item.items():
        if key not in ITEM_KEYS:
            problems.append(f"{where}: unknown keyword {key!r}")
        elif key in UNUSED_KEYS[section]:
            problems.append(f"{where}: {key!r} is not used by {section}")
        else:
            problems += _type_problem(f"{where}.{key}", value, ITEM_KEYS[key])
    for key in REQUIRED_KEYS[section]:
        if key not in item:
            problems.append(f"{where}: missing {key!r}")
    return problems


def _step_problems(section: str, name: str, step: object) -> list:
    where = f"{section}.{name}"
    if not isinstance(step, dict):
        return [f"{where} must be a map of keywords"]

    problems = []
    for key, value in step.items():
        if key not in STEP_KEYS:
            problems.append(f"{where}: unknown keyword {key!r}")
        else:
            problems += _type_problem(f"{where}.{key}", value, STEP_KEYS[key])
    if problems:
        return problems

    action = step.get("do")
    if ("run" in step) == ("do" in step):
        problems.append(f"{where} needs exactly one of 'run' or 'do'")
    if action is not None and action not in ACTIONS:
        problems.append(f"{where}.do must be one of: {', '.join(ACTIONS)}")
    if "message" in step and action != "push":
        problems.append(f"{where}: 'message' only goes with 'do: push'")
    if action == "push" and "message" not in step:
        problems.append(f"{where}: 'do: push' needs a 'message' for its commits")
    if step.get("choose") and action is not None and action not in ACTION_SECTIONS:
        problems.append(f"{where}: 'choose' only goes with "
                        f"'do: {', '.join(ACTION_SECTIONS)}' or with 'run'")
    if step.get("choose") and "run" in step and "options" not in step:
        problems.append(f"{where}: 'choose' on a 'run' step needs 'options'")
    if "options" in step and not ("run" in step and step.get("choose")):
        problems.append(f"{where}: 'options' only goes with 'run' and 'choose: true'")
    return problems


def _needs_cycle(items: dict) -> list:
    """A chain of `needs` that leads back to where it started, or []."""
    def follow(name: str, chain: list) -> list:
        if name in chain:
            return chain[chain.index(name):] + [name]
        for need in items[name].get("needs", []):
            if need in items:
                cycle = follow(need, chain + [name])
                if cycle:
                    return cycle
        return []

    for name in items:
        cycle = follow(name, [])
        if cycle:
            return cycle
    return []


def items_of(config: dict) -> dict:
    """Every item of relocated, tools, synced and repos by name, in file order."""
    return {name: item for section in ITEM_SECTIONS
            for name, item in config[section].items()}


def section_of(config: dict, name: str) -> str:
    """Which of relocated, tools, synced and repos holds the item `name`."""
    return next(section for section in ITEM_SECTIONS if name in config[section])


def check(config: object) -> list:
    """Every problem in a loaded config, as readable lines. Empty means fine."""
    if not isinstance(config, dict):
        return ["the file must be a map of sections (variables, relocated, tools, ...)"]

    problems = []
    for section in config:
        if section not in SECTIONS:
            problems.append(f"unknown section {section!r} "
                            f"(known: {', '.join(SECTIONS)})")
    if problems:
        return problems

    for section in SECTIONS:
        if not isinstance(config[section], dict):
            problems.append(f"{section} must be a map")
    if problems:
        return problems

    problems += _variables_problems("variables", config["variables"])

    for section in ITEM_SECTIONS + STEP_SECTIONS:
        for name in config[section]:
            if not isinstance(name, str):
                problems.append(f"{section}: the name {name!r} must be text "
                                "(put quotes around it)")
    if problems:
        return problems

    items = {}
    for section in ITEM_SECTIONS:
        for name, item in config[section].items():
            problems += _item_problems(section, name, item)
            if name in items:
                problems.append(f"{section}.{name}: the name {name!r} is already "
                                f"used in {items[name]}")
            items[name] = section
    for section in STEP_SECTIONS:
        for name, step in config[section].items():
            problems += _step_problems(section, name, step)
    if problems:
        return problems

    all_items = items_of(config)
    for name, item in all_items.items():
        for need in item.get("needs", []):
            if need not in all_items:
                problems.append(f"{items[name]}.{name}.needs: {need!r} is not "
                                f"an item in {', '.join(ITEM_SECTIONS)}")
    if problems:
        return problems

    cycle = _needs_cycle(all_items)
    if cycle:
        problems.append("needs go in a circle: " + " → ".join(cycle))
    return problems


def parse(text: str) -> object:
    """Load the text of a config file; check() it before using it.

    A section written with nothing under it, like `repos:`, becomes an empty
    map. Raises yaml.YAMLError when the text is not YAML.
    """
    config = yaml.load(text, Loader=_Loader)
    if isinstance(config, dict):
        for section in SECTIONS:
            if config.get(section) is None:
                config[section] = {}
    return config


def problems_in(text: str) -> list:
    """Every problem in the text of a config file, YAML mistakes included."""
    try:
        return check(parse(text))
    except yaml.YAMLError as error:
        return str(error).splitlines()


def load() -> dict:
    """Read and check ~/1337.yml."""
    try:
        config = parse(CONFIG_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        fail(f"{CONFIG_FILE} does not exist yet", [], "run 1337-setup to make it")
    except yaml.YAMLError as error:
        fail(f"{CONFIG_FILE} is not valid YAML", str(error).splitlines(),
             "fix it and run 1337 again")
    except OSError as error:
        fail(f"cannot read {CONFIG_FILE}", [str(error)], "fix it and run 1337 again")

    problems = check(config)
    if problems:
        count = "1 problem" if len(problems) == 1 else f"{len(problems)} problems"
        fail(f"{CONFIG_FILE} has {count}", problems, "fix it and run 1337 again")
    return config


# --------------------------------------------------------------------------
# Environment: variables, env and PATH
# --------------------------------------------------------------------------

class Problem(Exception):
    """A value in ~/1337.yml that cannot be used. The message says where."""


def expand(text: str, where: str) -> str:
    """Replace every $NAME in `text` with its value.

    A name that has no value is an error, never an empty string: an empty
    $GOINFRE in a path would point it somewhere else entirely.
    """
    result = os.path.expandvars(text)
    if "$" in result:
        raise Problem(f"{where}: {text!r} uses a variable that is not defined")
    return result


def expand_path(text: str, where: str) -> Path:
    """Expand a path and make sure it is absolute."""
    path = expand(text, where)
    if not path.startswith("/"):
        raise Problem(f"{where}: {text!r} must be an absolute path "
                      "(start it with / or a variable like $HOME)")
    return Path(os.path.normpath(path))


def source_of(name: str, item: dict) -> str:
    """The item's `source` with its variables filled in, or "" when it has none."""
    return expand(item["source"], f"{name}.source") if "source" in item else ""


def dest_of(name: str, item: dict) -> Path:
    return expand_path(item["dest"], f"{name}.dest")


def link_of(name: str, item: dict) -> Path:
    """The $HOME path of an item's `link`.

    Linking replaces whatever is at that path, so it must be inside $HOME and
    never $HOME itself.
    """
    link = expand_path(item["link"], f"{name}.link")
    if Path.home() not in link.parents:
        raise Problem(f"{name}.link: {item['link']!r} must be inside $HOME")
    return link


def paths_of(name: str, item: dict) -> list:
    return [expand_path(entry, f"{name}.path") for entry in item.get("path", [])]


def exported_names(config: dict) -> list:
    """Names of every variable 1337 sets: `variables`, then each item's `env`."""
    names = list(config["variables"])
    for item in items_of(config).values():
        names += [name for name in item.get("env", {}) if name not in names]
    return names


def add_to_path(folders: list) -> None:
    """Put the folders that exist at the front of PATH, once each, in order.

    A folder already on PATH is moved to the front rather than skipped, so
    1337's tools come before anything a shell added earlier, like pyenv's
    shims. Running it again changes nothing.
    """
    front = []
    for folder in folders:
        if folder.is_dir() and str(folder) not in front:
            front.append(str(folder))
    rest = [entry for entry in os.environ.get("PATH", "").split(":")
            if entry not in front]
    os.environ["PATH"] = ":".join(front + rest)


def prepare(config: dict) -> None:
    """Set every variable and env, check every path, and extend PATH.

    Everything 1337 runs afterwards inherits this environment.
    """
    problems = []
    for name, value in config["variables"].items():
        try:
            os.environ[name] = expand(str(value), f"variables.{name}")
        except Problem as problem:
            problems.append(str(problem))
    if problems:
        fail(f"{CONFIG_FILE} has a problem in its variables", problems,
             "fix it and run 1337 again")

    folders = []
    links = {}
    for name, item in items_of(config).items():
        try:
            for key, value in item.get("env", {}).items():
                os.environ[key] = expand(str(value), f"{name}.env.{key}")
            source_of(name, item)
            dest = dest_of(name, item)
            if "link" in item:
                link = link_of(name, item)
                # Linking deletes a real folder at the link, which must never
                # take the dest with it, or the other way around.
                if link == dest or link in dest.parents or dest in link.parents:
                    raise Problem(f"{name}: link and dest must not be inside "
                                  "each other")
                if link in links:
                    raise Problem(f"{name}.link: {link} is already the link "
                                  f"of {links[link]}")
                links[link] = name
            folders += paths_of(name, item)
        except Problem as problem:
            problems.append(str(problem))
    if problems:
        fail(f"{CONFIG_FILE} has a problem in its items", problems,
             "fix it and run 1337 again")

    add_to_path(folders)


def ready() -> dict:
    """~/1337.yml read and checked, with its environment set."""
    config = load()
    prepare(config)
    return config


# --------------------------------------------------------------------------
# Running steps
# --------------------------------------------------------------------------

#: Whether prompts are shown. Off with --all, and when there is no terminal
#: to answer them or to draw on (in that case every box keeps its start
#: state, and text answers are read from stdin).
ASK = sys.stdin.isatty() and sys.stdout.isatty()


def run_lines(lines: list, cwd: Path = None, extra: dict = None) -> bool:
    """Run `lines` as one bash script, its output going straight to the terminal.

    -e stops at the first failing line, -u makes an undefined $NAME an error
    instead of an empty string, and pipefail makes `a | b` fail when `a` fails.
    """
    environment = dict(os.environ, **(extra or {}))
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", "\n".join(lines)],
                            cwd=cwd, env=environment)
    return result.returncode == 0


def output_of(lines: list) -> list:
    """Run `lines` like run_lines and return their output lines, or None on failure.

    Empty lines and repeats are dropped; the order is kept.
    """
    result = subprocess.run(["bash", "-euo", "pipefail", "-c", "\n".join(lines)],
                            stdout=subprocess.PIPE, text=True)
    if result.returncode != 0:
        return None
    return list(dict.fromkeys(line.strip() for line in result.stdout.splitlines()
                              if line.strip()))


def pick(title: str, choices: list, checked: list = None) -> list:
    """The names picked in a checkbox prompt. When not asking, every box
    keeps its start state: checked, unless `checked` says otherwise."""
    if ASK:
        return choose(title, choices, checked)
    if checked is None:
        checked = [True] * len(choices)
    picked = [choice.name for choice, on in zip(choices, checked) if on]
    for line in _summary(title, picked):
        print(line)
    return picked


def heading(name: str) -> None:
    print(_line([("◆  ", CYAN), (name, BOLD + CYAN)]))


def result(name: str, ok: bool, ignored: bool = False) -> None:
    if ok:
        print(_line([("│  ", GRAY), ("✔ ", GREEN), (name, GREEN)], cut=False))
    elif ignored:
        print(_line([("│  ", GRAY), ("▲ ", YELLOW),
                     (f"{name} failed, continuing", YELLOW)], cut=False))
    else:
        print(_line([("│  ", GRAY), ("✖ ", RED), (f"{name} failed", RED)], cut=False))
    gap()


def run_step(config: dict, name: str, step: dict) -> bool:
    """Carry out one step of login or logout. True when it succeeded."""
    if "do" in step:
        return DO[step["do"]](config, name, step)

    if not step.get("choose"):
        heading(name)
        return run_lines(step["run"])

    options = output_of(step["options"])
    if options is None:
        heading(name)
        print(_line([("│  ", GRAY), ("the options lines failed", RED)]))
        return False
    picked = pick(name, [Choice(option) for option in options])
    skipped = [option for option in options if option not in picked]
    return run_lines(step["run"], extra={"CHOSEN": "\n".join(picked),
                                         "SKIPPED": "\n".join(skipped)})


def run_steps(config: dict, section: str) -> int:
    """Run the steps of login or logout in order. Returns the exit code.

    A failed step stops everything after it, unless it has ignore_errors.
    """
    intro(section)
    for name, step in config[section].items():
        ok = run_step(config, name, step)
        ignored = not ok and step.get("ignore_errors", False)
        result(name, ok, ignored)
        if not ok and not ignored:
            outro(f"{section} stopped at {name}", RED)
            return 1
    outro(f"{section} done")
    return 0


# --------------------------------------------------------------------------
# Items: setting up relocated folders, tools and repos, with what they need
# --------------------------------------------------------------------------

#: Items handled during this run, and whether they ended up ready. Shared by
#: every step, so a tool needed by two others is set up once.
DONE = {}


def note(symbol: str, style: str, name: str, text: str) -> None:
    """One line about one item, under the current step."""
    print(_line([("│  ", GRAY), (symbol + " ", style), (name, style),
                 ("  " + text, GRAY)], cut=False))


def _allow_and_retry(function, path: str, _error) -> None:
    """rmtree's error handler: make the folder writable, then try again.

    Some tools (Go's module cache, some npm packages) leave read-only
    folders, and nothing can be deleted from a read-only folder.
    """
    os.chmod(os.path.dirname(path), 0o700)
    if os.path.isdir(path) and not os.path.islink(path):
        os.chmod(path, 0o700)
    function(path)


def remove(path: Path) -> None:
    """Delete a file, a symlink or a whole folder. Nothing there is fine."""
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path, onerror=_allow_and_retry)


def setup_environment(name: str, item: dict, dest: Path) -> dict:
    """What an item's setup gets besides 1337's variables: $SOURCE, $DEST,
    and the item's own `path` folders at the front of PATH.

    Those folders do not exist yet when setup starts, but setup may create
    them and use them on its next line, like android's setup running the
    sdkmanager it has just unpacked.
    """
    folders = [str(folder) for folder in paths_of(name, item)]
    return {"SOURCE": source_of(name, item), "DEST": str(dest),
            "PATH": ":".join(folders + [os.environ.get("PATH", "")])}


def install_tool(config: dict, name: str, item: dict) -> bool:
    """Run a tool's setup if its dest does not exist yet.

    setup runs in a temporary folder next to dest, with $SOURCE and $DEST
    set, and must create dest. If it fails, or is interrupted, whatever it
    made of dest is removed so the next run starts over.
    """
    dest = dest_of(name, item)
    if dest.exists():
        note("·", GRAY, name, "already installed")
        return True

    note("●", CYAN, name, "installing")
    dest.parent.mkdir(parents=True, exist_ok=True)
    work = Path(tempfile.mkdtemp(prefix=f".{name}-", dir=dest.parent))
    ok = False
    try:
        ok = run_lines(item["setup"], cwd=work,
                       extra=setup_environment(name, item, dest))
        if ok and not dest.exists():
            note("✖", RED, name, f"setup finished but did not create {dest}")
            return False
    finally:
        remove(work)
        if not ok:
            remove(dest)

    if ok:
        note("✔", GREEN, name, "installed")
    else:
        note("✖", RED, name, "setup failed")
    return ok


def create_folder(config: dict, name: str, item: dict) -> bool:
    """Create a relocated folder's dest. Its setup, if any, runs inside it
    once, right after."""
    dest = dest_of(name, item)
    if dest.exists():
        return True

    dest.mkdir(parents=True)
    if "setup" not in item:
        return True

    ok = False
    try:
        ok = run_lines(item["setup"], cwd=dest,
                       extra=setup_environment(name, item, dest))
    finally:
        if not ok:
            remove(dest)
    if not ok:
        note("✖", RED, name, "setup failed")
    return ok


def short(path: Path) -> str:
    """A $HOME path written with ~, as people read it."""
    return "~" + str(path)[len(str(Path.home())):] if Path.home() in path.parents \
        else str(path)


def is_linked(link: Path, dest: Path) -> bool:
    """Whether `link` is a symlink that leads to `dest`."""
    return link.is_symlink() and os.path.realpath(link) == os.path.realpath(dest)


def keep_nested_links(config: dict, name: str, link: Path, dest: Path) -> None:
    """Move the links of other items out of a folder that is about to be
    deleted, into dest at the same place, where they are found through the
    new symlink.

    ~/.config/Code holds ~/.config/Code/User: relocating the first must not
    delete the second, which a new vscode-config repo takes in, or which is
    already vscode-config's symlink.
    """
    for other, item in items_of(config).items():
        if other == name or "link" not in item:
            continue
        nested = link_of(other, item)
        if link not in nested.parents or not (nested.is_symlink() or nested.exists()):
            continue
        target = dest / nested.relative_to(link)
        if target.is_symlink() or target.exists():
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(nested), str(target))
        note("·", GRAY, other, f"{short(nested)} kept, moved along with {name}")


def make_link(config: dict, name: str, item: dict) -> bool:
    """Make the item's link a symlink to its dest.

    A wrong or broken symlink is replaced. A real folder or file in the way
    of a relocated folder is deleted: it holds caches. In the way of a synced
    folder or repo, it is moved next to dest instead, where it stays until
    logout, in case it held something you want. Either way, the links of
    other items inside it are kept.
    """
    link = link_of(name, item)
    dest = dest_of(name, item)
    shown = short(link)

    if is_linked(link, dest):
        note("·", GRAY, name, f"{shown} already linked")
        return True

    replaced = ""
    if link.is_symlink():
        link.unlink()
    elif link.exists():
        keep_nested_links(config, name, link, dest)
        if section_of(config, name) in REPO_SECTIONS:
            aside = dest.with_name(dest.name + ".replaced")
            remove(aside)
            shutil.move(str(link), str(aside))
            replaced = f" (what was there is in {aside} until logout)"
        else:
            remove(link)
            replaced = " (replaced the real folder)"
    link.parent.mkdir(parents=True, exist_ok=True)
    link.symlink_to(dest)
    note("✔", GREEN, name, f"{shown} → {dest}{replaced}")
    return True


def remove_link(name: str, item: dict) -> None:
    """Remove the item's link, but only if it is our symlink to its dest."""
    link = link_of(name, item)
    if is_linked(link, dest_of(name, item)):
        link.unlink()
        note("✔", GREEN, name, f"{short(link)} unlinked")
    elif link.is_symlink() or link.exists():
        note("·", GRAY, name, f"{short(link)} is not our symlink, left alone")


def git(args: list, repo: Path = None, show: bool = False) -> subprocess.CompletedProcess:
    """Run git, in `repo` when given. Its output is captured unless `show`."""
    command = ["git"] + (["-C", str(repo)] if repo else []) + args
    if show:
        return subprocess.run(command, text=True)
    return subprocess.run(command, capture_output=True, text=True)


def git_lines(args: list, repo: Path) -> list:
    """The output lines of a git command that only reads."""
    return [line for line in git(args, repo).stdout.splitlines() if line]


def last_error(completed: subprocess.CompletedProcess) -> str:
    """The line of git's errors that says why: GitHub's own explanation (a
    refused permission, a file too big) when there is one, else the last."""
    lines = [line.strip() for line in completed.stderr.splitlines() if line.strip()]
    for line in lines:
        if line.startswith(("ERROR:", "remote: error:", "remote: ERROR:")):
            return line
    return lines[-1] if lines else f"exit code {completed.returncode}"


def sync_branches(name: str, repo: Path) -> None:
    """Give every branch on origin a local branch, fast-forwarded to origin's.

    A branch with local commits that origin does not have is left alone and
    reported: updating it would need a merge, which is your call.
    """
    remote = [branch for branch in git_lines(
        ["for-each-ref", "--format=%(refname:strip=3)", "refs/remotes/origin"], repo)
        if branch != "HEAD"]
    local = git_lines(["for-each-ref", "--format=%(refname:short)", "refs/heads"], repo)
    current = git(["symbolic-ref", "--quiet", "--short", "HEAD"], repo).stdout.strip()

    for branch in remote:
        if branch not in local:
            done = git(["branch", "--quiet", "--track", branch, f"origin/{branch}"], repo)
        elif branch == current:
            done = git(["merge", "--quiet", "--ff-only", f"origin/{branch}"], repo)
        else:
            done = git(["fetch", "--quiet", ".", f"origin/{branch}:{branch}"], repo)
        if done.returncode != 0:
            note("▲", YELLOW, name, f"branch {branch} not updated: {last_error(done)}")


def create_missing(config: dict, name: str, item: dict) -> bool:
    """After a failed clone: say why, and create the repo on GitHub when it is
    yours and is not there. True when it was created, so cloning can retry.

    A synced repo is created without asking: it is meant to start private
    and empty. A code repo is created only when you say so.
    """
    source = source_of(name, item)
    probe = git(["ls-remote", "--heads", source])
    if probe.returncode == 0:
        return False                  # it is there: git said above what went wrong
    if "Permission denied (publickey)" in probe.stderr:
        note("✖", RED, name, "GitHub does not know your SSH key: run 1337-setup")
        return False

    owner, repo, _ = repo_source(source, "")
    if not owner or owner.lower() != os.environ.get("GITHUB_USER", "").lower():
        note("✖", RED, name, f"{source} does not exist, or you cannot read it")
        return False
    token = saved_token()
    if not token:
        note("✖", RED, name, f"not on GitHub; create it, private and empty: "
                              f"{new_repo_link(repo)}")
        return False
    try:
        if find_repo(token, owner, repo):
            note("✖", RED, name, "on GitHub, but git cannot read it: run 1337-setup")
            return False
        if section_of(config, name) == "repos" and not (
                ASK and confirm(f"{repo} is not on GitHub. Create it, private?")):
            note("✖", RED, name, f"not on GitHub: {new_repo_link(repo)}")
            return False
        return create_repo(token, repo)
    except GitHubError as error:
        note("✖", RED, name, str(error))
        return False


def clone_repo(config: dict, name: str, item: dict) -> bool:
    """Clone a repo, or bring an existing clone up to date.

    A fresh clone gets a local branch for every branch on origin, then its
    setup runs inside it. If cloning or setup fails, the clone is removed so
    the next login tries again. A squash repo is cloned with only its last
    commit and is not updated afterwards: its history is replaced at logout.

    A repo of yours that is not on GitHub is created first (see
    create_missing). An empty repo has nothing to set up yet: its setup
    waits for a clone that has commits.
    """
    dest = dest_of(name, item)

    if (dest / ".git").exists():
        if item.get("squash"):
            note("·", GRAY, name, "already cloned")
            return True
        fetched = git(["fetch", "--quiet", "--all", "--prune"], dest)
        if fetched.returncode != 0:
            note("✖", RED, name, f"fetch failed: {last_error(fetched)}")
            return False
        sync_branches(name, dest)
        note("✔", GREEN, name, "up to date with origin")
        return True

    if dest.exists():
        note("✖", RED, name, f"{dest} exists but is not a git repo; move it away first")
        return False

    note("●", CYAN, name, "cloning")
    dest.parent.mkdir(parents=True, exist_ok=True)
    depth = ["--depth", "1"] if item.get("squash") else []
    clone = ["clone", *depth, source_of(name, item), str(dest)]
    ok = False
    try:
        cloned = git(clone, show=True)
        if cloned.returncode != 0 and create_missing(config, name, item):
            remove(dest)
            for wait in (0, 3):           # GitHub can take a moment to serve it
                time.sleep(wait)
                cloned = git(clone, show=True)
                if cloned.returncode == 0:
                    break
                remove(dest)
        if cloned.returncode != 0:
            note("✖", RED, name, "clone failed")
            return False
        empty = not git_lines(["for-each-ref", "refs/remotes/origin"], dest)
        if not item.get("squash"):
            sync_branches(name, dest)
        ok = empty or "setup" not in item or run_lines(
            item["setup"], cwd=dest,
            extra=setup_environment(name, item, dest))
        if not ok:
            note("✖", RED, name, "setup failed")
            return False
    finally:
        if not ok:
            remove(dest)

    # After the cleanup above on purpose: a failed clone or setup removes
    # dest, which must never take a folder adopted from $HOME with it.
    if empty:
        note("✔", GREEN, name, "cloned; the repo is empty"
                               + (", its setup waits for a first commit"
                                  if "setup" in item else ""))
        return start_empty_repo(name, item, dest)
    note("✔", GREEN, name, "cloned")
    return True


#: The branch a brand-new, empty repo starts on, as GitHub names it.
NEW_REPO_BRANCH = "main"

#: The branch a squash repo's single commit is made on, before it takes the
#: real branch's name.
SQUASH_BRANCH = "1337-squash"


def has_commits(repo: Path) -> bool:
    return git(["rev-parse", "--quiet", "--verify", "HEAD"], repo).returncode == 0


def start_empty_repo(name: str, item: dict, repo: Path) -> bool:
    """Prepare the clone of a repo that has no branches on origin yet.

    Its branch is named main before anything is committed. If the item has a
    link and a real folder is there, like an existing Chrome profile, that
    folder's contents move into the repo: the first logout pushes them,
    instead of the link deleting them. Then the item's `gitignore` lines
    become the repo's .gitignore, unless the folder brought its own.
    """
    git(["symbolic-ref", "HEAD", f"refs/heads/{NEW_REPO_BRANCH}"], repo)

    link = link_of(name, item) if "link" in item else None
    if link and not link.is_symlink() and link.is_dir():
        if (link / ".git").exists():
            note("✖", RED, name, f"{short(link)} is a git repo itself; move it away first")
            return False
        for entry in sorted(link.iterdir()):
            shutil.move(str(entry), str(repo / entry.name))
        link.rmdir()                      # empty now; the symlink takes its place
        note("✔", GREEN, name, f"the new repo took in everything from {short(link)}")

    ignore = repo / ".gitignore"
    if "gitignore" in item and not (ignore.is_symlink() or ignore.exists()):
        ignore.write_text("\n".join(item["gitignore"]) + "\n", encoding="utf-8")
        note("✔", GREEN, name, "the new repo starts with its .gitignore")
    return True


#: Files git keeps while a merge, rebase, cherry-pick or revert is half done.
UNFINISHED = ("MERGE_HEAD", "rebase-merge", "rebase-apply", "CHERRY_PICK_HEAD",
              "REVERT_HEAD")


def why_not_pushable(repo: Path) -> str:
    """Why committing everything in `repo` would be wrong, or "" when it is safe."""
    if git(["symbolic-ref", "--quiet", "HEAD"], repo).returncode != 0:
        return "HEAD is detached; check out a branch first"
    for marker in UNFINISHED:
        path = git(["rev-parse", "--git-path", marker], repo).stdout.strip()
        if (repo / path).exists():
            return "a merge or rebase is not finished; finish or abort it first"
    if git_lines(["stash", "list"], repo):
        return "it has stashes, which cannot be pushed; apply or drop them first"
    return ""


def commit_everything(repo: Path, message: str) -> subprocess.CompletedProcess:
    """`git add -A`, then commit if that staged anything."""
    added = git(["add", "-A"], repo)
    if added.returncode != 0:
        return added
    if git(["diff", "--cached", "--quiet"], repo).returncode == 0:
        return added
    return git(["commit", "--quiet", "-m", message], repo)


def push_repo(name: str, item: dict, message: str) -> bool:
    """Commit every change and push every branch and tag. True when origin has it all.

    Branches that are only behind origin are fast-forwarded first, so that a
    branch someone else pushed to does not block the push. A real conflict
    stops here, with the repo left as it was.
    """
    repo = dest_of(name, item)
    if not (repo / ".git").exists():
        note("·", GRAY, name, "not cloned on this machine")
        return True

    problem = why_not_pushable(repo)
    if problem:
        note("✖", RED, name, problem)
        return False

    committed = commit_everything(repo, message)
    if committed.returncode != 0:
        note("✖", RED, name, f"commit failed: {last_error(committed)}")
        return False

    fetched = git(["fetch", "--quiet", "--all", "--prune"], repo)
    if fetched.returncode != 0:
        note("✖", RED, name, f"fetch failed: {last_error(fetched)}")
        return False

    if git(["rev-parse", "--quiet", "--verify", "@{upstream}"], repo).returncode == 0:
        rebased = git(["rebase", "--quiet", "@{upstream}"], repo)
        if rebased.returncode != 0:
            git(["rebase", "--abort"], repo)
            note("✖", RED, name, "your commits conflict with origin's; the rebase "
                                 "was undone, merge them by hand")
            return False

    sync_branches(name, repo)

    pushes = []
    if unpushed_branches(repo):
        pushes.append(["push", "--quiet", "--all", "-u", "origin"])
    if unpushed_tags(repo):
        pushes.append(["push", "--quiet", "--tags", "origin"])
    if not pushes:
        note("·", GRAY, name, "nothing new to push")
        return True

    for push in pushes:
        pushed = git(push, repo)
        if pushed.returncode != 0:
            note("✖", RED, name, f"push failed: {last_error(pushed)}")
            return False

    note("✔", GREEN, name, "pushed")
    return True


def unpushed_branches(repo: Path) -> bool:
    """Whether a local branch has commits that origin does not, as of the
    last fetch.

    Asking first matters: an empty repo with nothing committed has no branch
    to push, and git refuses a push of nothing; a repo you can only read
    refuses any push, even of nothing new.
    """
    for branch in git_lines(["for-each-ref", "--format=%(refname:short)",
                             "refs/heads"], repo):
        remote = f"refs/remotes/origin/{branch}"
        if git(["rev-parse", "--quiet", "--verify", remote], repo).returncode != 0:
            return True
        if git_lines(["rev-list", f"{remote}..refs/heads/{branch}"], repo):
            return True
    return False


def unpushed_tags(repo: Path) -> bool:
    """Whether a local tag is missing on origin, or points somewhere else."""
    local = set(git_lines(["for-each-ref", "--format=%(objectname)\t%(refname)",
                           "refs/tags"], repo))
    if not local:
        return False
    listed = git(["ls-remote", "--tags", "--refs", "origin"], repo)
    if listed.returncode != 0:
        return True                   # cannot tell: try the push, which says why
    return not local <= set(line for line in listed.stdout.splitlines() if line)


def push_squashed(name: str, item: dict, message: str) -> bool:
    """Replace a squash repo's history with one commit of its current files,
    and force-push it."""
    repo = dest_of(name, item)
    if not (repo / ".git").exists():
        note("·", GRAY, name, "not cloned on this machine")
        return True

    branch = git(["symbolic-ref", "--quiet", "--short", "HEAD"], repo).stdout.strip()
    if not branch:
        note("✖", RED, name, "HEAD is detached; check out a branch first")
        return False
    if branch == SQUASH_BRANCH:
        # A logout stopped half way through: push to origin's branch, not this one.
        head = git(["symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"],
                   repo).stdout.strip()
        branch = head.removeprefix("origin/") or NEW_REPO_BRANCH

    # A new repo has no history to replace: its first commit is already alone.
    start_over = [["checkout", "--quiet", "--orphan", SQUASH_BRANCH]] \
        if has_commits(repo) else []
    for command in (*start_over,
                    ["add", "-A"],
                    ["commit", "--quiet", "--allow-empty", "-m", message],
                    ["branch", "--quiet", "-M", branch],
                    ["push", "--quiet", "--force", "origin", branch]):
        done = git(command, repo)
        if done.returncode != 0:
            note("✖", RED, name, f"git {command[0]} failed: {last_error(done)}")
            return False

    note("✔", GREEN, name, "pushed as a single commit")
    return True


def unlisted_repos(config: dict) -> list:
    """Git repos next to your repos that ~/1337.yml does not list.

    They are looked for in the folders that hold your `repos` (like
    $WORKSPACE), because a repo cloned there by hand would otherwise be
    wiped at logout without anyone noticing.
    """
    listed = {dest_of(name, item) for section in REPO_SECTIONS
              for name, item in config[section].items()}
    found = []
    for folder in sorted({dest_of(name, item).parent
                          for name, item in config["repos"].items()}):
        if not folder.is_dir():
            continue
        for child in sorted(folder.iterdir()):
            if (child / ".git").exists() and child not in listed:
                found.append(child)
    return found


#: How each section sets up one of its items.
SET_UP = {
    "relocated": create_folder,
    "tools": install_tool,
    "synced": clone_repo,
    "repos": clone_repo,
}


def set_up(config: dict, name: str) -> bool:
    """Set up one item, after everything it needs. True when it is ready.

    Its `path` folders go on PATH right away, so the items after it can use
    what it installed.
    """
    if name in DONE:
        return DONE[name]

    item = items_of(config)[name]
    for need in item.get("needs", []):
        if not set_up(config, need):
            note("✖", RED, name, f"skipped: needs {need}")
            DONE[name] = False
            return False

    section = section_of(config, name)
    try:
        ok = SET_UP[section](config, name, item)
        if ok and "link" in item:
            ok = make_link(config, name, item)
    except OSError as error:
        note("✖", RED, name, str(error))
        ok = False
    if ok:
        add_to_path(paths_of(name, item))
    DONE[name] = ok
    return ok


def ready_tag(config: dict, name: str, item: dict) -> str:
    """What the picker shows in green next to an item that needs no work."""
    section = section_of(config, name)
    if section == "tools" and dest_of(name, item).exists():
        return "installed"
    if section == "relocated" and is_linked(link_of(name, item), dest_of(name, item)):
        return "linked"
    if section in REPO_SECTIONS and (dest_of(name, item) / ".git").exists():
        return "cloned"
    return ""


def choices_for(config: dict, section: str) -> list:
    return [Choice(name, item["dest"], item.get("needs", []),
                   ready_tag(config, name, item))
            for name, item in config[section].items()]


def set_up_all(config: dict, names: list) -> bool:
    """Set up each item in `names`. Every one is tried, even after a failure."""
    results = [set_up(config, name) for name in names]
    return all(results)


def do_set_up(config: dict, name: str, step: dict) -> bool:
    """`do: link`, `do: install`, `do: sync` and `do: clone`: set up the items
    of one section, all of them or the ones picked."""
    section = ACTION_SECTIONS[step["do"]]
    if step.get("choose"):
        names = pick(name, choices_for(config, section))
    else:
        heading(name)
        names = list(config[section])
    return set_up_all(config, names)


def do_push(config: dict, name: str, step: dict) -> bool:
    """`do: push`: every synced folder and repo on this machine. All are
    tried; any failure fails the step."""
    heading(name)
    results = []
    for section in REPO_SECTIONS:
        for repo_name, item in config[section].items():
            push = push_squashed if item.get("squash") else push_repo
            try:
                results.append(push(repo_name, item, step["message"]))
            except OSError as error:
                note("✖", RED, repo_name, str(error))
                results.append(False)

    for repo in unlisted_repos(config):
        note("▲", YELLOW, short(repo),
             "is a git repo that ~/1337.yml does not list: it is not pushed")
    return all(results)


def do_unlink(config: dict, name: str, step: dict) -> bool:
    """`do: unlink`: remove every link 1337 made."""
    heading(name)
    ok = True
    for item_name, item in items_of(config).items():
        if "link" not in item:
            continue
        try:
            remove_link(item_name, item)
        except OSError as error:
            note("✖", RED, item_name, str(error))
            ok = False
    return ok


#: What each `do:` keyword runs.
DO = {
    "link": do_set_up,
    "install": do_set_up,
    "sync": do_set_up,
    "clone": do_set_up,
    "push": do_push,
    "unlink": do_unlink,
}


# --------------------------------------------------------------------------
# GitHub: signing in, creating repos, the SSH key
# --------------------------------------------------------------------------

#: The OAuth app `1337 setup` signs in with: you open a link, type a code,
#: and GitHub hands a token to this script. A client ID is public by design,
#: the device flow has no secret. Empty: setup asks to paste a token instead.
GITHUB_CLIENT_ID = ""

#: What the token may do: create private repos, add your SSH key, read your email.
GITHUB_SCOPES = ("repo", "write:public_key", "user:email")

TOKEN_FILE = Path.home() / ".config" / "1337" / "github-token"
TOKEN_LINK = ("https://github.com/settings/tokens/new?description=1337-config"
              "&scopes=" + ",".join(GITHUB_SCOPES))


class GitHubError(Exception):
    """GitHub could not be reached. The message says why."""


def _send(request: urllib.request.Request) -> tuple:
    """Send a request to GitHub. Returns (status, the decoded JSON answer)."""
    request.add_header("User-Agent", "1337-config")
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            status, body = response.status, response.read()
    except urllib.error.HTTPError as error:
        status, body = error.code, error.read()
    except OSError as error:                    # no network, DNS, timeout
        raise GitHubError(f"cannot reach GitHub: {getattr(error, 'reason', error)}")
    try:
        return status, json.loads(body or b"{}")
    except ValueError:
        return status, {}


def api(method: str, path: str, token: str, body: dict = None) -> tuple:
    """Call the GitHub REST API as you. Returns (status, answer)."""
    request = urllib.request.Request(
        "https://api.github.com" + path, method=method,
        data=None if body is None else json.dumps(body).encode())
    request.add_header("Accept", "application/vnd.github+json")
    request.add_header("Authorization", f"Bearer {token}")
    if body is not None:
        request.add_header("Content-Type", "application/json")
    return _send(request)


def _post_form(url: str, fields: dict) -> dict:
    """POST a form to github.com, as the device flow wants. Returns the answer."""
    request = urllib.request.Request(url, data=urllib.parse.urlencode(fields).encode())
    request.add_header("Accept", "application/json")
    answer = _send(request)[1]
    return answer if isinstance(answer, dict) else {}


def show_link(label: str, url: str) -> None:
    """A link to open, on its own line so the terminal makes it clickable."""
    print(_line([("│  ", GRAY), (label + "  ", GRAY), (url, BOLD + WHITE)], cut=False))


def device_login() -> str:
    """Sign in with a link and a code. The token, or "" when it did not happen."""
    started = _post_form("https://github.com/login/device/code",
                         {"client_id": GITHUB_CLIENT_ID, "scope": " ".join(GITHUB_SCOPES)})
    if "device_code" not in started:
        note("✖", RED, "github", started.get("error_description", "sign-in did not start"))
        return ""

    show_link("open", started["verification_uri"])
    print(_line([("│  ", GRAY), ("code  ", GRAY), (started["user_code"], BOLD + GREEN)]))
    print(_line([("│  ", GRAY), ("type the code on that page, then approve", GRAY)]))
    print(_line([("│  ", GRAY), ("waiting for you to approve it on github.com...", GRAY)]))

    interval = started.get("interval", 5)
    deadline = time.monotonic() + started.get("expires_in", 900)
    while time.monotonic() < deadline:
        time.sleep(interval)
        answer = _post_form("https://github.com/login/oauth/access_token", {
            "client_id": GITHUB_CLIENT_ID,
            "device_code": started["device_code"],
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code"})
        if "access_token" in answer:
            return answer["access_token"]
        if answer.get("error") == "slow_down":
            interval = answer.get("interval", interval + 5)
        elif answer.get("error") != "authorization_pending":
            note("✖", RED, "github", answer.get("error_description", "sign-in failed"))
            return ""
    note("✖", RED, "github", "the code expired")
    return ""


def pasted_token() -> str:
    """Ask for a token made on github.com, on a page with its boxes already ticked."""
    show_link("open", TOKEN_LINK)
    print(_line([("│  ", GRAY),
                 ("pick an expiration, click Generate token, copy it", GRAY)]))
    return ask("Paste the token", secret=True)


def saved_token() -> str:
    try:
        return TOKEN_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def save_token(token: str) -> None:
    """Keep the token in $HOME, readable by you only, for the next setup."""
    TOKEN_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    handle = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(handle, "w", encoding="utf-8") as file:
        file.write(token + "\n")
    TOKEN_FILE.chmod(0o600)


def github_login(asking: bool = True) -> tuple:
    """(token, username) of your GitHub account, or ("", "") without one.

    A token saved by an earlier setup is used while GitHub still accepts it.
    Otherwise, when `asking`, you are offered to sign in.
    """
    token = saved_token()
    if token:
        status, user = api("GET", "/user", token)
        if status == 200:
            note("✔", GREEN, "github", f"signed in as {user['login']}")
            gap()
            return token, user["login"]
    if not asking or not confirm("Sign in to GitHub? 1337 then creates your "
                                 "private repos and adds your SSH key"):
        return "", ""

    token = device_login() if GITHUB_CLIENT_ID else pasted_token()
    if not token:
        gap()
        return "", ""
    status, user = api("GET", "/user", token)
    if status != 200:
        note("✖", RED, "github", "GitHub refused that token")
        gap()
        return "", ""
    save_token(token)
    note("✔", GREEN, "github", f"signed in as {user['login']}")
    gap()
    return token, user["login"]


def github_email(token: str) -> str:
    """The primary email of your GitHub account, or ""."""
    status, emails = api("GET", "/user/emails", token)
    if status != 200 or not isinstance(emails, list):
        return ""
    return next((entry["email"] for entry in emails if entry.get("primary")), "")


def find_repo(token: str, owner: str, name: str) -> dict:
    """What GitHub says about a repo, or {} when it does not exist for you."""
    status, repo = api("GET", f"/repos/{owner}/{name}", token)
    return repo if status == 200 and isinstance(repo, dict) else {}


def create_repo(token: str, name: str) -> bool:
    """Create an empty, private repo on your account."""
    status, answer = api("POST", "/user/repos", token, {"name": name, "private": True})
    if status == 201:
        note("✔", GREEN, name, "created on GitHub, private")
        return True
    note("✖", RED, name, f"not created on GitHub: {answer.get('message', status)}")
    return False


#: SSH keys looked for in ~/.ssh, in order; the first that exists is used.
SSH_KEYS = ("id_ed25519", "id_ecdsa", "id_rsa")


def ssh_reaches_github() -> bool:
    """Whether git can clone and push over SSH with a key of yours."""
    try:
        done = subprocess.run(
            ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
             "-o", "StrictHostKeyChecking=accept-new", "git@github.com"],
            capture_output=True, text=True)
    except OSError:
        return False
    return "successfully authenticated" in done.stderr


def ensure_ssh_key(token: str, email: str) -> bool:
    """Make sure GitHub knows an SSH key of yours: repos are cloned and pushed with it.

    The key already in ~/.ssh is used, or a new one is made. With a token it
    is added to GitHub directly, without one you add it on the page shown.
    """
    if ssh_reaches_github():
        note("✔", GREEN, "ssh", "GitHub knows your key")
        return True

    folder = Path.home() / ".ssh"
    key = next((folder / f"{name}.pub" for name in SSH_KEYS
                if (folder / f"{name}.pub").exists()), None)
    if key is None:
        folder.mkdir(mode=0o700, exist_ok=True)
        key = folder / "id_ed25519.pub"
        made = subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "",
                               "-C", email, "-f", str(folder / "id_ed25519")])
        if made.returncode != 0:
            note("✖", RED, "ssh", "ssh-keygen failed")
            return False
        note("✔", GREEN, "ssh", f"made a new key, {short(key)}")

    text = key.read_text(encoding="utf-8").strip()
    if token:
        status, answer = api("POST", "/user/keys", token,
                             {"title": f"1337-config {socket.gethostname()}", "key": text})
        if status == 201:
            note("✔", GREEN, "ssh", f"{short(key)} added to GitHub")
        else:
            note("▲", YELLOW, "ssh", f"GitHub did not take {short(key)}: "
                                     f"{answer.get('message', status)}")
    else:
        gap()
        show_link("open", "https://github.com/settings/ssh/new")
        print(_line([("│  ", GRAY), ("paste this as the key:", GRAY)]))
        print(_line([("│  ", GRAY), (text, WHITE)], cut=False))
        gap()
        confirm("Added it on GitHub?")

    if ssh_reaches_github():
        note("✔", GREEN, "ssh", "GitHub knows your key")
        return True
    note("▲", YELLOW, "ssh", "GitHub still refuses your key: cloning and pushing will fail")
    return False


def new_repo_link(name: str) -> str:
    return f"https://github.com/new?name={urllib.parse.quote(name)}&visibility=private"


# --------------------------------------------------------------------------
# Writing ~/1337.yml: setup and repo
# --------------------------------------------------------------------------

@dataclass
class Block:
    """Lines of a config file: its header, a section line, or one item or step."""

    section: str                          # "" for the header
    name: str                             # "" for the header and section lines
    lines: list


def blocks(text: str) -> list:
    """Split the text of a config file into blocks, keeping every comment.

    A section starts at a line with no indent, an item or step at a line
    indented by exactly 4 spaces. Comments, blank and deeper lines belong to
    the block above them, so joining every block gives the text back.
    """
    found = [Block("", "", [])]
    for line in text.splitlines():
        key = line.split(":", 1)[0].strip()
        if re.match(r"[^\s#]", line):
            found.append(Block(key, "", [line]))
        elif re.match(r" {4}[^\s#]", line) and found[-1].section:
            found.append(Block(found[-1].section, key, [line]))
        else:
            found[-1].lines.append(line)
    return found


def _trimmed(lines: list) -> list:
    """`lines` without the blank lines at their end."""
    end = len(lines)
    while end and not lines[end - 1].strip():
        end -= 1
    return lines[:end]


def _own_length(lines: list) -> int:
    """How many lines of an item block are the item itself: its first line
    and the deeper ones under it, not the comments and blank lines after it."""
    length = 1
    for index, line in enumerate(lines[1:], start=2):
        if line.strip() and not line.startswith(" " * 5):
            break
        if line.strip():
            length = index
    return length


def _comment(line: str) -> str:
    """The comment at the end of a line, without its #."""
    return line.split("#", 1)[1].strip() if "#" in line else ""


def _scalar(value: str) -> str:
    """`value` written as YAML: bare when YAML reads it back as the same text."""
    try:
        if yaml.safe_load(value) == value and "#" not in value:
            return value
    except yaml.YAMLError:
        pass
    return json.dumps(value)


def _with_value(line: str, value: str) -> str:
    """A `    NAME: value  # comment` line with a new value. The comment stays."""
    key = line.split(":", 1)[0]
    head = f"{key}: {_scalar(value)}"
    if "#" not in line:
        return head
    column = line.index("#")
    return head.ljust(column - 1) + " " + line[column:]


def save_config(text: str) -> None:
    """Replace ~/1337.yml in one step, so it is never half written.

    A ~/1337.yml that is a symlink, into a dotfiles repo say, stays one.
    """
    target = CONFIG_FILE.resolve()
    temporary = target.with_name(f".{target.name}.new")
    temporary.write_text(text, encoding="utf-8")
    os.replace(temporary, target)


def repo_source(spec: str, user: str) -> tuple:
    """(owner, name, git URL) of what you typed: a name, owner/name or a URL.

    A bare name is one of your repos. GitHub links become SSH URLs, which
    push without a password. Any other URL is kept as it is, with owner "".
    """
    spec = spec.strip().rstrip("/")
    if re.fullmatch(r"[\w.-]+", spec):
        spec = f"{user}/{spec}"
    match = re.fullmatch(r"(?:(?:https?://)?(?:www\.)?github\.com/|git@github\.com:"
                         r"|ssh://git@github\.com/)?([\w-]+)/([\w.-]+?)(?:\.git)?", spec)
    if match:
        owner, name = match.groups()
        return owner, name, f"git@github.com:{owner}/{name}.git"
    return "", re.sub(r"\.git$", "", re.split(r"[/:]", spec)[-1]), spec


def repo_lines(name: str, source: str) -> list:
    return [f"    {name}:",
            f"        source: {_scalar(source)}",
            f"        dest: $WORKSPACE/{name}"]


def name_problem(name: str, taken: set) -> str:
    """Why `name` cannot name a new repo, or ""."""
    if not re.fullmatch(r"[A-Za-z0-9][\w.-]*", name) or _scalar(name) != name:
        return f"{name!r} cannot be a name in ~/1337.yml"
    if name in taken:
        return f"the name {name!r} is already used"
    return ""


def with_repo(text: str, name: str, source: str) -> str:
    """`text` with a repo added at the end of its repos section."""
    found = blocks(text)
    section = [block for block in found if block.section == "repos"]
    entry = repo_lines(name, source)
    if not section:
        return "\n".join(_trimmed(text.splitlines()) + ["", "repos:"] + entry) + "\n"
    if section[0].lines[0].split("#")[0].strip() != "repos:":
        raise Problem("its repos section is not written as `repos:` on a line of "
                      "its own; add the repo by hand")

    lines = []
    for block in found:
        if block is section[-1]:
            kept = _trimmed(block.lines)
            lines += kept + entry + block.lines[len(kept):]
        else:
            lines += block.lines
    return "\n".join(lines) + "\n"


def without_repo(text: str, name: str) -> str:
    """`text` without the repo `name`. Comments after it stay."""
    lines = []
    for block in blocks(text):
        if block.section == "repos" and block.name == name:
            lines += block.lines[_own_length(block.lines):]
        else:
            lines += block.lines
    return "\n".join(lines) + "\n"


#: login and logout steps that only make sense with one synced item.
STEPS_WITH = {
    "chrome": "google-cache",
    "vscode": "vscode-config",
    "extensions": "vscode-config",
}

#: login and logout steps that setup offers as extras.
EXTRAS = {
    "display": "at login: screen at 2560x1440, normal text size",
    "docker": "at logout: stop docker, delete its images",
}

#: Tools ticked the first time setup runs; the others are one key away.
SUGGESTED_TOOLS = ("code", "node", "uv")

#: Where `1337-setup` and the other shell functions find this runner. A
#: logout wipes goinfre, so they clone it again when it is missing.
RUNNER = "/goinfre/$USER/1337-config"
RUNNER_URL = "https://github.com/mohammedhrima/1337-config.git"

SHELL_START = "# >>> 1337-config >>>"
SHELL_END = "# <<< 1337-config <<<"
SHELL_LINES = f"""{SHELL_START}
# written by `1337 setup`, which rewrites everything between these two lines
export PATH="{RUNNER}:$PATH"
1337-get()    {{ [ -d "{RUNNER}" ] || git clone -q {RUNNER_URL} "{RUNNER}"; }}
1337-setup()  {{ 1337-get && 1337 setup && eval "$(1337 env)"; }}
1337-login()  {{ 1337-get && 1337 login "$@"; eval "$(1337 env)"; }}
1337-logout() {{ 1337 logout; }}
1337-repo()   {{ 1337-get && 1337 repo "$@" && eval "$(1337 env)"; }}
[ -x "{RUNNER}/1337" ] && eval "$(1337 env)"
{SHELL_END}"""


def config_text(example: str, answers: dict, repos: list) -> str:
    """The text of ~/1337.yml: the example cut down to your answers.

    `answers` holds the picked names of relocated, tools, synced and extras,
    and the values of the variables to fill in. `repos` are the blocks of
    the whole repos section, written as they are.
    """
    lines = []
    for block in blocks(example):
        if block.section == "repos":
            if block.name:
                continue
            chosen = repos
        elif block.name and not _kept(block, answers):
            continue
        elif block.section == "variables" and block.name in answers["variables"]:
            value = answers["variables"][block.name]
            chosen = [Block("variables", block.name,
                            [_with_value(block.lines[0], value)] + block.lines[1:])]
        else:
            chosen = [block]

        for kept in chosen:
            if not kept.name and kept.section and lines:
                lines.append("")              # a blank line before each section
            lines += _trimmed(kept.lines)
    return "\n".join(lines) + "\n"


def _kept(block: Block, answers: dict) -> bool:
    """Whether an item or step of the example goes into your ~/1337.yml."""
    if block.section in ("relocated", "tools", "synced"):
        return block.name in answers[block.section]
    if block.section in STEP_SECTIONS:
        if block.name in EXTRAS:
            return block.name in answers["extras"]
        if block.name in STEPS_WITH:
            return STEPS_WITH[block.name] in answers["synced"]
    return True


def add_needed(answers: dict, example: dict, repos: dict) -> None:
    """Pick every item of the example that a picked item or a repo needs."""
    known = {**items_of(example), **repos}
    picked = [name for section in ("relocated", "tools", "synced")
              for name in answers[section]] + list(repos)
    for name in picked:                       # grows while it is walked
        for need in known.get(name, {}).get("needs", []):
            if need in picked or need in repos or need not in known:
                continue
            answers[section_of(example, need)].append(need)
            picked.append(need)
            note("▲", YELLOW, need, f"picked too: {name} needs it")


def old_config() -> tuple:
    """(text, config) of the current ~/1337.yml, or ("", None) when there is
    none or it is broken; setup then starts from the example."""
    try:
        text = CONFIG_FILE.read_text(encoding="utf-8")
        config = parse(text)
    except FileNotFoundError:
        return "", None
    except (OSError, yaml.YAMLError):
        config = None
    if config is None or check(config):
        note("▲", YELLOW, "1337.yml", "has problems: starting from the example")
        gap()
        return "", None
    return text, config


def _ask_valid(title: str, default: str, rule: str, valid) -> str:
    """ask() until the answer is valid."""
    answer = ask(title, default if valid(default) else "")
    while not valid(answer):
        if not ASK:
            fail(f"{title}: {answer or 'nothing'} is not valid", [rule],
                 "run 1337 setup again")
        note("✖", RED, title, rule)
        gap()
        answer = ask(title)
    return answer


def _picker(example: dict, comments: dict, section: str) -> list:
    """The choices of one section of the example, for setup."""
    choices = []
    for name, item in example[section].items():
        where = item["link"].replace("$HOME", "~") if "link" in item else ""
        detail = "  ".join(part for part in (where, comments[section, name]) if part)
        choices.append(Choice(name, detail, item.get("needs", [])))
    return choices


def write_shell_lines() -> None:
    """Add 1337-login and its friends to your shell, or refresh them."""
    shell = os.environ.get("SHELL", "")
    rc = Path.home() / (".bashrc" if shell.endswith("bash") else ".zshrc")
    try:
        text = rc.read_text(encoding="utf-8")
    except FileNotFoundError:
        text = ""

    if SHELL_START in text and SHELL_END in text:
        before, rest = text.split(SHELL_START, 1)
        updated = before + SHELL_LINES + rest.split(SHELL_END, 1)[1]
    elif confirm(f"Add 1337-login, 1337-logout, 1337-repo and 1337-setup "
                 f"to {short(rc)}?"):
        updated = text + ("\n" if text and not text.endswith("\n") else "") \
            + "\n" + SHELL_LINES + "\n"
    else:
        return

    if updated != text:
        rc.write_text(updated, encoding="utf-8")
        note("✔", GREEN, short(rc), "has the 1337 commands")
    else:
        note("·", GRAY, short(rc), "already has the 1337 commands")
    if "42-config" in text:
        note("▲", YELLOW, short(rc), "still has lines for the old 42-config: "
                                      "delete them by hand")


def cmd_setup(args: list) -> int:
    """Ask a few questions, then write ~/1337.yml and the shell's 1337 commands."""
    if args:
        fail("1337 setup takes no arguments", [], "run: 1337 setup")
    example_text = EXAMPLE_FILE.read_text(encoding="utf-8")
    example = parse(example_text)
    comments = {(block.section, block.name): _comment(block.lines[0])
                for block in blocks(example_text) if block.name}

    intro("setup")
    text, old = old_config()
    try:
        token, login = github_login()
    except GitHubError as error:
        note("▲", YELLOW, "github", f"{error}; going on without it")
        gap()
        token, login = "", ""

    variables = old["variables"] if old else {}
    user = _ask_valid(
        "GitHub username", str(variables.get("GITHUB_USER", "")) or login,
        "letters, digits and - only",
        lambda answer: re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?", answer))
    email = str(variables.get("GITHUB_EMAIL", ""))
    if "@" not in email and token:
        email = github_email(token)
    if "@" not in email:
        email = git(["config", "--global", "user.email"]).stdout.strip()
    email = _ask_valid("GitHub email, for your commits", email, "an email address",
                       lambda answer: re.fullmatch(r"[^@\s]+@[^@\s]+", answer))

    picks = {}
    for section, title in (
            ("relocated", "Relocate: $HOME folders moved to goinfre, emptied at logout"),
            ("synced", "Sync: $HOME folders kept in a private GitHub repo"),
            ("tools", "Tools: offered at every login")):
        if old:
            on = [name in old[section] for name in example[section]]
        else:
            on = [section != "tools" or name in SUGGESTED_TOOLS
                  for name in example[section]]
        picks[section] = pick(title, _picker(example, comments, section), on)

    if old:
        on = [name in old["login"] or name in old["logout"] for name in EXTRAS]
    else:
        on = [name == "docker" for name in EXTRAS]
    picks["extras"] = pick("Extras", [Choice(name, what) for name, what in EXTRAS.items()],
                           on)

    # Your repos stay as they are, comments and all; new ones go at the end.
    if old:
        repos = [block for block in blocks(text) if block.section == "repos"]
        repo_items = dict(old["repos"])
    else:
        repos = [block for block in blocks(example_text)
                 if block.section == "repos" and not block.name]
        repo_items = {}
    if repo_items:
        for line in _answered("Repos you have", ", ".join(repo_items)):
            print(line)
    taken = set(items_of(example)) | set(repo_items)
    new_repos = []
    while True:
        spec = ask("Add a repo? Its name, owner/name or URL; enter when done")
        if not spec:
            break
        owner, name, source = repo_source(spec, user)
        problem = name_problem(name, taken)
        if problem:
            note("✖", RED, spec, problem)
            gap()
            continue
        taken.add(name)
        repos.append(Block("repos", name, repo_lines(name, source)))
        repo_items[name] = {}
        new_repos.append((owner, name))

    add_needed(picks, example, repo_items)
    answers = {**picks, "variables": {"GITHUB_USER": user, "GITHUB_EMAIL": email}}
    new_text = config_text(example_text, answers, repos)
    problems = problems_in(new_text)
    if problems:
        fail("the new ~/1337.yml would have problems", problems,
             "nothing was written; edit ~/1337.yml by hand")

    heading("files")
    if old:
        backup = CONFIG_FILE.with_name("1337.yml.bak")
        shutil.copyfile(CONFIG_FILE, backup)
        note("✔", GREEN, short(CONFIG_FILE), f"written; the old one is {short(backup)}")
    else:
        note("✔", GREEN, short(CONFIG_FILE), "written")
    save_config(new_text)
    # Now, not only at login: a logout commits, and git refuses without these.
    git(["config", "--global", "user.name", user])
    git(["config", "--global", "user.email", email])
    write_shell_lines()
    gap()

    heading("github")
    try:
        ensure_ssh_key(token, email)
        synced = [repo_source(example["synced"][name]["source"]
                              .replace("$GITHUB_USER", user), user)[:2]
                  for name in picks["synced"]]
        mine = synced + [(owner, name) for owner, name in new_repos
                         if owner.lower() == user.lower()]
        for owner, name in mine:
            if not token:
                show_link(name, new_repo_link(name))
                continue
            repo = find_repo(token, owner, name)
            if not repo:
                create_repo(token, name)
            elif not repo.get("private") and (owner, name) in synced:
                note("▲", YELLOW, name, "is PUBLIC: anyone can read your cookies "
                                        "and settings; make it private on GitHub")
            else:
                note("·", GRAY, name, "already on GitHub")
        if not token and mine:
            print(_line([("│  ", GRAY), ("make each one above on GitHub: private, "
                                         "with nothing in it", GRAY)]))
    except GitHubError as error:
        note("▲", YELLOW, "github", str(error))
    gap()

    outro("done. Next: 1337-login")
    return 0


def _repo_usage() -> None:
    fail("1337 repo takes add or remove, then names",
         ["1337-repo add <name | owner/name | URL>...",
          "1337-repo remove <name>..."],
         "1337-repo alone lists your repos")


def cmd_repo(args: list) -> int:
    """`1337 repo`: list your repos, add some, or take some out."""
    config = ready()
    if not args or args == ["list"]:
        intro("repos")
        for name, item in config["repos"].items():
            note("·", GRAY, name, f"{item['source']}  {ready_tag(config, name, item)}")
        if not config["repos"]:
            note("·", GRAY, "none yet", "add one: 1337-repo add <name>")
        outro("add one: 1337-repo add <name | owner/name | URL>", GRAY)
        return 0
    if args[0] not in ("add", "remove") or len(args) < 2:
        _repo_usage()

    text = CONFIG_FILE.read_text(encoding="utf-8")
    intro(f"repo {args[0]}")
    if args[0] == "remove":
        for name in args[1:]:
            if name not in config["repos"]:
                fail(f"{name} is not in the repos of ~/1337.yml",
                     list(config["repos"]) or ["(there are none)"], "nothing was changed")
            text = without_repo(text, name)
    else:
        user = str(config["variables"].get("GITHUB_USER", ""))
        taken = set(items_of(config))
        added = []
        for spec in args[1:]:
            owner, name, source = repo_source(spec, user)
            problem = name_problem(name, taken)
            if problem:
                fail(problem, [], "nothing was changed")
            try:
                text = with_repo(text, name, source)
            except Problem as problem:
                fail(f"cannot add {name} to ~/1337.yml", [str(problem)],
                     "nothing was changed")
            taken.add(name)
            added.append((owner, name))

    problems = problems_in(text)
    if problems:
        fail("~/1337.yml would have problems", problems, "nothing was changed")
    save_config(text)

    if args[0] == "remove":
        for name in args[1:]:
            note("✔", GREEN, name, "taken out of ~/1337.yml; its clone is not "
                                   "pushed at logout anymore")
        outro("done")
        return 0

    for _, name in added:
        note("✔", GREEN, name, "added to ~/1337.yml")
    gap()

    # Cloning offers to create a repo of yours that is not on GitHub yet.
    config = load()
    heading("clone")
    if set_up_all(config, [name for _, name in added]):
        outro("done")
        return 0
    outro("added, but not cloned; 1337-login tries again", RED)
    return 1


