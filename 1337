def cmd_help(args: list) -> int:
    config = ready() if CONFIG_FILE.exists() else None
    intro("session runner for /goinfre")
    width = max(len(usage) for usage, _ in USAGE) + 3
    for usage, meaning in USAGE:
        print(_line([("│  ", GRAY), (usage.ljust(width), WHITE), (meaning, GRAY)], cut=False))
    gap()
    if config is None:
        print(_line([("└  ", GRAY), ("config".ljust(width), WHITE),
                     ("none yet: run 1337-setup", YELLOW)], cut=False))
        return 0
    tools = ", ".join(config["tools"]) or "none yet"
    print(_line([("│  ", GRAY), ("tools".ljust(width), WHITE), (tools, GRAY)], cut=False))
    print(_line([("└  ", GRAY), ("config".ljust(width), WHITE),
                 (str(CONFIG_FILE), GRAY)], cut=False))
    return 0


def cmd_install(args: list) -> int:
    """`1337 install name...` installs those tools; without names, it asks."""
    global ASK
    config = ready()
    if "--all" in args:
        ASK = False
    names = [arg for arg in args if arg != "--all"]
    unknown = [name for name in names if name not in config["tools"]]
    if unknown:
        fail("not a tool in ~/1337.yml: " + ", ".join(unknown), [],
             "tools: " + (", ".join(config["tools"]) or "none"))

    intro("install")
    if not names:
        names = pick("tools", choices_for(config, "tools"))
    else:
        heading("tools")
    if set_up_all(config, names):
        outro("installed. For this terminal: eval \"$(1337 env)\"")
        return 0
    outro("some tools failed", RED)
    return 1


COMMANDS = {
    "setup": cmd_setup,
    "login": cmd_login,
    "logout": cmd_logout,
    "repo": cmd_repo,
    "install": cmd_install,
    "env": cmd_env,
    "help": cmd_help,
}


def main(args: list) -> int:
    # Line by line, so 1337's lines and the commands' output stay in order
    # even when everything goes to a file or a pipe.
    sys.stdout.reconfigure(line_buffering=True)

    command = args[0] if args else "help"
    if command in ("-h", "--help"):
        command = "help"
    if command not in COMMANDS:
        fail(f"unknown command {command!r}", [], "run 1337 to see the commands")
    try:
        return COMMANDS[command](args[1:])
    except KeyboardInterrupt:
        print()
        outro("cancelled", RED)
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
