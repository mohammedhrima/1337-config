def cmd_env(args: list) -> int:
    """Print `export` lines for the shell to evaluate.

    Only exports reach stdout. Running it twice gives the same PATH, because
    a folder already on PATH is never added again. Before setup there is
    nothing to export.
    """
    if args:
        fail("1337 env takes no arguments", [], "run: eval \"$(1337 env)\"")
    if not CONFIG_FILE.exists():
        return 0
    config = ready()
    for name in exported_names(config) + ["PATH"]:
        print(f"export {name}={shlex.quote(os.environ.get(name, ''))}")
    return 0


